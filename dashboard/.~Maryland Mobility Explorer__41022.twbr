  <worksheets>
    <worksheet name='Housing Squeeze - &quot;8 Countiessaw rent burden rise while real income fell&quot;'>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_county_change' name='federated.1j8edpq1m58e9b1ds7hxo0cqv7o6' />
          </datasources>
          <datasource-dependencies datasource='federated.1j8edpq1m58e9b1ds7hxo0cqv7o6'>
            <column caption='Squeezed' datatype='string' name='[Calculation_2819075664687106]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [income_change_pct] &lt; 0 AND [rent_burden_change_pts] &gt; 0&#10;   THEN &quot;Squeezed&quot; ELSE &quot;Not squeezed&quot; END' />
            </column>
            <column caption='County Name' datatype='string' name='[county_name]' role='dimension' semantic-role='[County].[Name]' type='nominal' />
            <column caption='Income Change Pct' datatype='real' name='[income_change_pct]' role='measure' type='quantitative' />
